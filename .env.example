# PostgreSQL Configuration (for Docker/Production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=amazon_db

# Database URL (Docker Compose will construct this automatically)
# For manual override:
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/amazon_db

# For SQLite (development only):
# DATABASE_URL=sqlite+aiosqlite:///./test.db

# JWT Secret (generate a secure random string, minimum 32 characters)
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters

# Shop Cookie Secret (generate a secure random string, minimum 32 characters)
SHOP_COOKIE_SECRET=your_shop_cookie_secret_here_minimum_32_characters
